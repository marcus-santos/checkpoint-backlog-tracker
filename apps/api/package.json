{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply checkpoint-db --local",
    "db:studio": "node ./scripts/link-d1-studio-db.mjs && drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "howlongtobeat": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bcryptjs": "^2.4.6",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.4.0"
  }
}
